---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Embed demo | Irish Driving Data"
  description="Test page for the Irish Driving Data embeddable centre widget."
  canonicalPath="/embed-demo/"
>
  <p class="eyebrow">Developers</p>
  <h1>Embed demo</h1>
  <p class="lede">
    Paste a single script tag to show a centre’s latest pass rate and wait time
    on your own site. The widget includes a credit link back to Irish Driving
    Data.
  </p>

  <h2>Script embed</h2>
  <pre
    class="panel"
    style="overflow:auto; font-family: var(--font-mono); font-size: 0.85rem;"
  ><code>&lt;div data-idd-centre="dun-laoghaire"&gt;&lt;/div&gt;
&lt;script async src="https://www.irishdrivingdata.ie/embed.js"&gt;&lt;/script&gt;</code></pre>

  <div data-idd-centre="dun-laoghaire"></div>
  <script is:inline src="/embed.js"></script>

  <h2 style="margin-top: 2rem;">Iframe fallback</h2>
  <iframe
    title="Dún Laoghaire embed"
    src="/embed/dun-laoghaire/"
    style="width: min(100%, 24rem); height: 11rem; border: 0;"
  ></iframe>
</BaseLayout>
