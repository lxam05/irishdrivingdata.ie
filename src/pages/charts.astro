---
import BaseLayout from '../layouts/BaseLayout.astro';
import DriveFlowCta from '../components/DriveFlowCta.astro';
import { data, explorerPayload, formatPeriod } from '../lib/centres';

const payload = explorerPayload();
const { meta } = data;
const defaultSlug =
  payload.centres.find((c) => c.slug === 'dun-laoghaire')?.slug ??
  payload.centres[0]?.slug ??
  '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Irish driving test centre charts',
  description:
    'Explore Category B pass rates, national ranking, waiting times, and trends for any RSA test centre in Ireland.',
  url: `${meta.siteUrl}/charts/`,
  applicationCategory: 'ReferenceApplication',
  operatingSystem: 'Any',
  creator: {
    '@type': 'Person',
    name: "Liam O'Connor",
    url: `${meta.siteUrl}/about/#author`,
  },
};
---

<BaseLayout
  title={`Irish driving test centre charts (${meta.lastUpdatedLabel}) | Irish Driving Data`}
  description="Pick any RSA test centre to see pass rate vs national average, Ireland rank, tests conducted, 12-month change, waiting times, and trend charts."
  canonicalPath="/charts/"
  jsonLd={jsonLd}
>
  <section class="explorer" id="explorer" data-default={defaultSlug}>
    <p class="eyebrow">Centre charts · {meta.lastUpdatedLabel}</p>
    <h1>Irish driving test centre charts</h1>
    <p class="lede">
      Select a centre to see how it compares nationally — pass rate, Ireland rank, tests
      conducted, twelve-month change, and waiting time — with trend charts underneath.
    </p>

    <div class="explorer-picker">
      <label for="centre-select">
        Test centre
        <select id="centre-select" autocomplete="off">
          {
            payload.centres.map((c) => (
              <option value={c.slug} selected={c.slug === defaultSlug}>
                {c.name} ({c.county})
              </option>
            ))
          }
        </select>
      </label>
      <p class="explorer-picker__meta" id="centre-meta"></p>
      <p class="explorer-picker__routes">
        <a id="driveflow-inline" href="#" target="_blank" rel="noopener">View practice routes on DriveFlow</a>
      </p>
    </div>

    <div class="explorer-stats" id="explorer-stats" aria-live="polite"></div>

    <p class="source-line" id="explorer-source">
      Source: {meta.citationLong ?? meta.citation}. Snapshot {formatPeriod(meta.period)}.
    </p>

    <div class="explorer-charts">
      <figure class="chart-panel">
        <figcaption>
          <h2>Pass rate vs national</h2>
          <p>Monthly Category B pass rate for this centre against the Ireland average. Hover for exact figures.</p>
        </figcaption>
        <div class="chart-wrap">
          <canvas id="chart-pass" width="900" height="320" aria-label="Pass rate trend chart"></canvas>
        </div>
        <div class="chart-legend" id="legend-pass"></div>
      </figure>

      <figure class="chart-panel">
        <figcaption>
          <h2>Waiting time</h2>
          <p>Estimated weeks to a test invite at month end (CSO ROA36). Hover for exact figures.</p>
        </figcaption>
        <div class="chart-wrap">
          <canvas id="chart-wait" width="900" height="280" aria-label="Waiting time trend chart"></canvas>
        </div>
        <div class="chart-legend" id="legend-wait"></div>
      </figure>

      <figure class="chart-panel">
        <figcaption>
          <h2>Last 12 months — tests conducted</h2>
          <p>Delivered, no-shows, and abandoned Category B tests at this centre. Hover a month for counts.</p>
        </figcaption>
        <div class="chart-wrap">
          <canvas id="chart-volume" width="900" height="300" aria-label="Tests volume chart"></canvas>
        </div>
        <div class="chart-legend" id="legend-volume"></div>
      </figure>

      <figure class="chart-panel">
        <figcaption>
          <h2>Where this centre ranks</h2>
          <p>Pass-rate distribution across all RSA centres; this centre is highlighted. Hover any bar for the centre name and rate.</p>
        </figcaption>
        <div class="chart-wrap">
          <canvas id="chart-rank" width="900" height="260" aria-label="Pass rate ranking chart"></canvas>
        </div>
        <div class="chart-legend" id="legend-rank"></div>
      </figure>
    </div>

    <div class="chart-tooltip" id="chart-tooltip" hidden role="tooltip"></div>

    <p class="actions" style="margin-top: 1.5rem">
      <a class="btn" id="centre-page-link" href={`/centres/${defaultSlug}/`}>Full centre history</a>
      <a class="btn" href="/">Back to tracker</a>
    </p>
  </section>

  <DriveFlowCta
    href={payload.centres.find((c) => c.slug === defaultSlug)?.driveflowUrl ?? 'https://www.driveflow.ie/'}
  />

  <script type="application/json" id="explorer-data" set:html={JSON.stringify(payload)} />

  <script>
    const payload = JSON.parse(document.getElementById('explorer-data').textContent || '{}');
    const centres = payload.centres || [];
    const bySlug = Object.fromEntries(centres.map((c) => [c.slug, c]));
    const nationalHistory = payload.meta?.nationalHistory || [];
    const nationalByPeriod = Object.fromEntries(nationalHistory.map((h) => [h.period, h]));

    const root = document.getElementById('explorer');
    const select = document.getElementById('centre-select');
    const statsEl = document.getElementById('explorer-stats');
    const metaEl = document.getElementById('centre-meta');
    const linkEl = document.getElementById('centre-page-link');
    const driveflowInline = document.getElementById('driveflow-inline');
    const driveflowCta = document.querySelector('.df-cta__btn');
    const sourceEl = document.getElementById('explorer-source');

    const COLORS = {
      accent: '#0c6e5a',
      accentSoft: '#7eb8a8',
      ink: '#14201a',
      muted: '#4a5a52',
      line: '#d5ddd7',
      warn: '#8a5a12',
      danger: '#9b2c2c',
      grid: 'rgba(20, 32, 26, 0.08)',
      fill: 'rgba(12, 110, 90, 0.12)',
      national: '#8a5a12',
      delivered: '#0c6e5a',
      noShow: '#8a5a12',
      abandoned: '#9b2c2c',
      highlight: '#0c6e5a',
      other: '#b7c4bc',
    };

    function fmt(v, suffix = '') {
      if (v == null || Number.isNaN(v)) return '—';
      return `${v}${suffix}`;
    }

    function fmtCount(v) {
      if (v == null) return '—';
      return Number(v).toLocaleString('en-IE');
    }

    function fmtDelta(v, unit) {
      if (v == null) return '—';
      const sign = v > 0 ? '+' : '';
      if (unit === 'pp') return `${sign}${v} pp`;
      if (unit === 'w') return `${sign}${v} w`;
      return `${sign}${v}`;
    }

    function deltaClass(v) {
      if (v == null || v === 0) return 'delta-flat';
      return v > 0 ? 'delta-up' : 'delta-down';
    }

    function shortPeriod(period) {
      const [y, m] = period.split('-');
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      return `${months[Number(m) - 1]} ${y.slice(2)}`;
    }

    function renderStats(c) {
      const vsNat =
        c.passRate != null && payload.meta?.national?.passRate != null
          ? Math.round((c.passRate - payload.meta.national.passRate) * 10) / 10
          : null;

      statsEl.innerHTML = `
        <article class="explorer-stat">
          <p class="explorer-stat__label">Pass rate</p>
          <p class="explorer-stat__value">${fmt(c.passRate, '%')}</p>
          <p class="explorer-stat__note ${deltaClass(vsNat)}">${
            vsNat == null ? 'vs national —' : `${fmtDelta(vsNat, 'pp')} vs national`
          }</p>
        </article>
        <article class="explorer-stat">
          <p class="explorer-stat__label">National average</p>
          <p class="explorer-stat__value">${fmt(payload.meta?.national?.passRate, '%')}</p>
          <p class="explorer-stat__note">Ireland · ${payload.meta?.lastUpdatedLabel || ''}</p>
        </article>
        <article class="explorer-stat">
          <p class="explorer-stat__label">Ireland rank</p>
          <p class="explorer-stat__value">${c.passRateRank == null ? '—' : `#${c.passRateRank}`}</p>
          <p class="explorer-stat__note">of ${c.rankOf} centres with a published pass rate</p>
        </article>
        <article class="explorer-stat">
          <p class="explorer-stat__label">Tests conducted</p>
          <p class="explorer-stat__value">${fmtCount(c.delivered)}</p>
          <p class="explorer-stat__note">Delivered this month</p>
        </article>
        <article class="explorer-stat">
          <p class="explorer-stat__label">12-month change</p>
          <p class="explorer-stat__value ${deltaClass(c.passRate12m)}">${fmtDelta(c.passRate12m, 'pp')}</p>
          <p class="explorer-stat__note">Pass rate vs ~12 months earlier</p>
        </article>
        <article class="explorer-stat">
          <p class="explorer-stat__label">Waiting weeks</p>
          <p class="explorer-stat__value">${fmt(c.waitWeeks)}</p>
          <p class="explorer-stat__note ${deltaClass(c.waitWeeks12m)}">${
            c.waitWeeks12m == null
              ? '12-month wait change —'
              : `${fmtDelta(c.waitWeeks12m, 'w')} over 12 months`
          }</p>
        </article>
      `;

      metaEl.textContent = `${c.name} · ${c.county} · Category B`;
      if (linkEl) {
        linkEl.href = `/centres/${c.slug}/`;
        linkEl.textContent = `Full ${c.name} history`;
      }
      if (driveflowInline) {
        driveflowInline.href =
          c.driveflowUrl || `https://www.driveflow.ie/${c.slug}-routes.html`;
        driveflowInline.textContent = `View ${c.name} practice routes on DriveFlow`;
      }
      if (driveflowCta) {
        driveflowCta.setAttribute(
          'href',
          c.driveflowUrl || `https://www.driveflow.ie/${c.slug}-routes.html`,
        );
      }
      if (sourceEl) {
        sourceEl.innerHTML = `Showing <strong>${c.name}</strong>. Source: CSO ROA30 / ROA36 via data.cso.ie. Snapshot ${payload.meta?.lastUpdatedLabel || ''}.`;
      }
    }

    function setupCanvas(id) {
      const canvas = document.getElementById(id);
      if (!canvas) return null;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      const cssW = Math.max(Math.round(rect.width) || canvas.clientWidth || 320, 320);
      const intrinsicH = Number(canvas.getAttribute('height')) || 300;
      const intrinsicW = Number(canvas.getAttribute('width')) || 900;
      const cssH = Math.round(intrinsicH * (cssW / intrinsicW));
      canvas.style.width = '100%';
      canvas.style.height = `${cssH}px`;
      const needResize =
        canvas.width !== Math.round(cssW * dpr) || canvas.height !== Math.round(cssH * dpr);
      if (needResize) {
        canvas.width = Math.round(cssW * dpr);
        canvas.height = Math.round(cssH * dpr);
      }
      const ctx = canvas.getContext('2d');
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return { canvas, ctx, w: cssW, h: cssH };
    }

    function pointerPos(canvas, evt, logicalW, logicalH) {
      const rect = canvas.getBoundingClientRect();
      const clientX = evt.touches ? evt.touches[0].clientX : evt.clientX;
      const clientY = evt.touches ? evt.touches[0].clientY : evt.clientY;
      return {
        x: ((clientX - rect.left) / Math.max(rect.width, 1)) * logicalW,
        y: ((clientY - rect.top) / Math.max(rect.height, 1)) * logicalH,
        clientX,
        clientY,
      };
    }

    const tooltip = document.getElementById('chart-tooltip');
    const chartState = {};

    function showTooltip(html, clientX, clientY) {
      if (!tooltip) return;
      tooltip.innerHTML = html;
      tooltip.hidden = false;
      const pad = 14;
      const tw = tooltip.offsetWidth;
      const th = tooltip.offsetHeight;
      let left = clientX + pad;
      let top = clientY + pad;
      if (left + tw > window.innerWidth - 8) left = clientX - tw - pad;
      if (top + th > window.innerHeight - 8) top = clientY - th - pad;
      tooltip.style.left = `${Math.max(8, left)}px`;
      tooltip.style.top = `${Math.max(8, top)}px`;
    }

    function hideTooltip() {
      if (tooltip) tooltip.hidden = true;
    }

    function bindChart(id, paint) {
      const canvas = document.getElementById(id);
      if (!canvas) return;
      if (!canvas.dataset.bound) {
        canvas.dataset.bound = '1';
        canvas.style.cursor = 'crosshair';
        const onMove = (evt) => {
          const state = chartState[id];
          if (!state?.hitTest) return;
          const pos = pointerPos(canvas, evt, state.w || canvas.clientWidth, state.h || canvas.clientHeight);
          const hit = state.hitTest(pos.x, pos.y);
          state.hover = hit;
          paint(state.centre, hit);
          if (hit?.html) showTooltip(hit.html, pos.clientX, pos.clientY);
          else hideTooltip();
        };
        const onLeave = () => {
          const state = chartState[id];
          if (!state) return;
          state.hover = null;
          paint(state.centre, null);
          hideTooltip();
        };
        canvas.addEventListener('mousemove', onMove);
        canvas.addEventListener('mouseleave', onLeave);
        canvas.addEventListener('touchstart', onMove, { passive: true });
        canvas.addEventListener('touchmove', onMove, { passive: true });
        canvas.addEventListener('touchend', onLeave);
      }
    }

    function drawAxes(ctx, pad, w, h) {
      ctx.strokeStyle = COLORS.line;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(pad.l, pad.t);
      ctx.lineTo(pad.l, h - pad.b);
      ctx.lineTo(w - pad.r, h - pad.b);
      ctx.stroke();
    }

    function yTicks(ctx, pad, w, h, min, max, fmtFn) {
      const steps = 4;
      ctx.fillStyle = COLORS.muted;
      ctx.font = '12px "IBM Plex Mono", monospace';
      ctx.textAlign = 'right';
      ctx.textBaseline = 'middle';
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const v = max - t * (max - min);
        const y = pad.t + t * (h - pad.t - pad.b);
        ctx.strokeStyle = COLORS.grid;
        ctx.beginPath();
        ctx.moveTo(pad.l, y);
        ctx.lineTo(w - pad.r, y);
        ctx.stroke();
        ctx.fillStyle = COLORS.muted;
        ctx.fillText(fmtFn(v), pad.l - 8, y);
      }
    }

    function xLabels(ctx, pad, w, h, labels, every) {
      ctx.fillStyle = COLORS.muted;
      ctx.font = '11px "IBM Plex Mono", monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      const n = labels.length;
      if (n < 2) return;
      const plotW = w - pad.l - pad.r;
      for (let i = 0; i < n; i++) {
        if (i % every !== 0 && i !== n - 1) continue;
        const x = pad.l + (i / (n - 1)) * plotW;
        ctx.fillText(labels[i], x, h - pad.b + 8);
      }
    }

    function linePath(ctx, points, color, fill) {
      if (points.length < 2) return;
      ctx.beginPath();
      points.forEach((p, i) => {
        if (i === 0) ctx.moveTo(p.x, p.y);
        else ctx.lineTo(p.x, p.y);
      });
      ctx.strokeStyle = color;
      ctx.lineWidth = 2.25;
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';
      ctx.stroke();
      if (fill) {
        const first = points[0];
        const last = points[points.length - 1];
        ctx.lineTo(last.x, fill);
        ctx.lineTo(first.x, fill);
        ctx.closePath();
        ctx.fillStyle = COLORS.fill;
        ctx.fill();
      }
    }

    function drawHoverGuide(ctx, x, pad, h) {
      ctx.strokeStyle = 'rgba(20, 32, 26, 0.28)';
      ctx.lineWidth = 1;
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(x, pad.t);
      ctx.lineTo(x, h - pad.b);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    function drawDot(ctx, x, y, color) {
      ctx.fillStyle = '#fff';
      ctx.beginPath();
      ctx.arc(x, y, 4.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    function longPeriod(period) {
      const [y, m] = period.split('-').map(Number);
      const months = [
        'January', 'February', 'March', 'April', 'May', 'June',
        'July', 'August', 'September', 'October', 'November', 'December',
      ];
      return `${months[m - 1]} ${y}`;
    }

    function paintPassChart(c, hover) {
      const setup = setupCanvas('chart-pass');
      if (!setup) return;
      const { canvas, ctx, w, h } = setup;
      ctx.clearRect(0, 0, w, h);
      const pad = { t: 16, r: 16, b: 36, l: 44 };
      const hist = (c.history || []).filter((p) => p.passRate != null);
      const periods = hist.map((p) => p.period);
      const centreVals = hist.map((p) => p.passRate);
      const natVals = periods.map((p) => nationalByPeriod[p]?.passRate).filter((v) => v != null);
      const all = [...centreVals, ...natVals];
      if (all.length < 2) {
        ctx.fillStyle = COLORS.muted;
        ctx.font = '14px "Source Sans 3", sans-serif';
        ctx.fillText('Not enough pass-rate history for this centre.', pad.l, h / 2);
        chartState['chart-pass'] = { centre: c, hitTest: () => null };
        return;
      }
      const min = Math.min(...all) - 2;
      const max = Math.max(...all) + 2;
      const plotW = w - pad.l - pad.r;
      const plotH = h - pad.t - pad.b;
      yTicks(ctx, pad, w, h, min, max, (v) => `${v.toFixed(0)}%`);
      drawAxes(ctx, pad, w, h);

      const points = periods.map((period, i) => {
        const pass = centreVals[i];
        const nat = nationalByPeriod[period]?.passRate ?? null;
        const x = pad.l + (i / (periods.length - 1)) * plotW;
        const y = pad.t + ((max - pass) / (max - min || 1)) * plotH;
        const natY =
          nat == null ? null : pad.t + ((max - nat) / (max - min || 1)) * plotH;
        return { period, pass, nat, x, y, natY };
      });

      const centrePts = points.map((p) => ({ x: p.x, y: p.y }));
      const natPts = points
        .filter((p) => p.natY != null)
        .map((p) => ({ x: p.x, y: p.natY }));

      if (hover) drawHoverGuide(ctx, hover.x, pad, h);
      linePath(ctx, natPts, COLORS.national, null);
      linePath(ctx, centrePts, COLORS.accent, pad.t + plotH);
      if (hover) {
        drawDot(ctx, hover.x, hover.y, COLORS.accent);
        if (hover.natY != null) drawDot(ctx, hover.x, hover.natY, COLORS.national);
      }

      xLabels(ctx, pad, w, h, periods.map(shortPeriod), Math.ceil(periods.length / 8));
      const legend = document.getElementById('legend-pass');
      if (legend) {
        legend.innerHTML = `
          <span><i style="background:${COLORS.accent}"></i>${c.name}</span>
          <span><i style="background:${COLORS.national}"></i>National average</span>
        `;
      }

      chartState['chart-pass'] = {
        centre: c,
        w,
        h,
        hitTest(mx) {
          if (!points.length) return null;
          let best = points[0];
          let bestDist = Infinity;
          for (const p of points) {
            const d = Math.abs(p.x - mx);
            if (d < bestDist) {
              bestDist = d;
              best = p;
            }
          }
          if (bestDist > plotW / points.length + 12) return null;
          const diff =
            best.nat == null ? null : Math.round((best.pass - best.nat) * 10) / 10;
          return {
            ...best,
            html: `<strong>${longPeriod(best.period)}</strong>
              <div>${c.name}: <b>${best.pass}%</b></div>
              <div>National: <b>${best.nat == null ? '—' : best.nat + '%'}</b></div>
              ${diff == null ? '' : `<div>Gap: <b>${diff > 0 ? '+' : ''}${diff} pp</b></div>`}`,
          };
        },
      };
      bindChart('chart-pass', paintPassChart);
    }

    function paintWaitChart(c, hover) {
      const setup = setupCanvas('chart-wait');
      if (!setup) return;
      const { ctx, w, h } = setup;
      ctx.clearRect(0, 0, w, h);
      const pad = { t: 16, r: 16, b: 36, l: 44 };
      const hist = (c.history || []).filter((p) => p.waitWeeks != null);
      if (hist.length < 2) {
        ctx.fillStyle = COLORS.muted;
        ctx.font = '14px "Source Sans 3", sans-serif';
        ctx.fillText('Waiting-time history starts September 2021 where published.', pad.l, h / 2);
        chartState['chart-wait'] = { centre: c, hitTest: () => null };
        return;
      }
      const periods = hist.map((p) => p.period);
      const vals = hist.map((p) => p.waitWeeks);
      const natVals = periods.map((p) => nationalByPeriod[p]?.waitWeeks).filter((v) => v != null);
      const all = [...vals, ...natVals];
      const min = Math.max(0, Math.min(...all) - 1);
      const max = Math.max(...all) + 1;
      const plotW = w - pad.l - pad.r;
      const plotH = h - pad.t - pad.b;
      yTicks(ctx, pad, w, h, min, max, (v) => `${v.toFixed(0)}w`);
      drawAxes(ctx, pad, w, h);

      const points = periods.map((period, i) => {
        const wait = vals[i];
        const nat = nationalByPeriod[period]?.waitWeeks ?? null;
        const x = pad.l + (i / (periods.length - 1)) * plotW;
        const y = pad.t + ((max - wait) / (max - min || 1)) * plotH;
        const natY =
          nat == null ? null : pad.t + ((max - nat) / (max - min || 1)) * plotH;
        return { period, wait, nat, x, y, natY };
      });

      if (hover) drawHoverGuide(ctx, hover.x, pad, h);
      linePath(
        ctx,
        points.filter((p) => p.natY != null).map((p) => ({ x: p.x, y: p.natY })),
        COLORS.national,
        null,
      );
      linePath(
        ctx,
        points.map((p) => ({ x: p.x, y: p.y })),
        COLORS.accent,
        null,
      );
      const last = points[points.length - 1];
      drawDot(ctx, last.x, last.y, COLORS.accent);
      if (hover) {
        drawDot(ctx, hover.x, hover.y, COLORS.accent);
        if (hover.natY != null) drawDot(ctx, hover.x, hover.natY, COLORS.national);
      }

      xLabels(ctx, pad, w, h, periods.map(shortPeriod), Math.ceil(periods.length / 7));
      const legend = document.getElementById('legend-wait');
      if (legend) {
        legend.innerHTML = `
          <span><i style="background:${COLORS.accent}"></i>${c.name}</span>
          <span><i style="background:${COLORS.national}"></i>National wait</span>
        `;
      }

      chartState['chart-wait'] = {
        centre: c,
        w,
        h,
        hitTest(mx) {
          let best = points[0];
          let bestDist = Infinity;
          for (const p of points) {
            const d = Math.abs(p.x - mx);
            if (d < bestDist) {
              bestDist = d;
              best = p;
            }
          }
          if (bestDist > plotW / points.length + 12) return null;
          const diff =
            best.nat == null ? null : Math.round((best.wait - best.nat) * 10) / 10;
          return {
            ...best,
            html: `<strong>${longPeriod(best.period)}</strong>
              <div>${c.name}: <b>${best.wait} weeks</b></div>
              <div>National: <b>${best.nat == null ? '—' : best.nat + ' weeks'}</b></div>
              ${diff == null ? '' : `<div>Gap: <b>${diff > 0 ? '+' : ''}${diff} w</b></div>`}`,
          };
        },
      };
      bindChart('chart-wait', paintWaitChart);
    }

    function paintVolumeChart(c, hover) {
      const setup = setupCanvas('chart-volume');
      if (!setup) return;
      const { ctx, w, h } = setup;
      ctx.clearRect(0, 0, w, h);
      const pad = { t: 16, r: 12, b: 40, l: 44 };
      const hist = (c.history || []).slice(-12);
      if (!hist.length) {
        ctx.fillStyle = COLORS.muted;
        ctx.font = '14px "Source Sans 3", sans-serif';
        ctx.fillText('No volume data for this centre.', pad.l, h / 2);
        chartState['chart-volume'] = { centre: c, hitTest: () => null };
        return;
      }
      const max = Math.max(
        1,
        ...hist.map((p) => Math.max(p.delivered || 0, p.noShow || 0, p.abandoned || 0)),
      );
      const plotW = w - pad.l - pad.r;
      const plotH = h - pad.t - pad.b;
      const groupW = plotW / hist.length;
      const barW = Math.max(4, groupW * 0.22);
      yTicks(ctx, pad, w, h, 0, max, (v) => `${Math.round(v)}`);
      drawAxes(ctx, pad, w, h);

      const groups = hist.map((p, i) => {
        const x0 = pad.l + i * groupW + groupW * 0.15;
        const metrics = [
          { key: 'delivered', label: 'Delivered', v: p.delivered, color: COLORS.delivered },
          { key: 'noShow', label: 'No-shows', v: p.noShow, color: COLORS.noShow },
          { key: 'abandoned', label: 'Abandoned', v: p.abandoned, color: COLORS.abandoned },
        ].map((m, mi) => {
          const v = m.v || 0;
          const bh = (v / max) * plotH;
          const x = x0 + mi * (barW + 2);
          const y = pad.t + plotH - bh;
          return { ...m, v, x, y, w: barW, h: bh };
        });
        return {
          period: p.period,
          x0: pad.l + i * groupW,
          x1: pad.l + (i + 1) * groupW,
          metrics,
        };
      });

      if (hover) {
        ctx.fillStyle = 'rgba(12, 110, 90, 0.08)';
        ctx.fillRect(hover.x0, pad.t, hover.x1 - hover.x0, plotH);
      }

      groups.forEach((g) => {
        g.metrics.forEach((m) => {
          ctx.fillStyle = m.color;
          ctx.globalAlpha = hover && hover.period !== g.period ? 0.35 : 1;
          ctx.fillRect(m.x, m.y, m.w, Math.max(m.h, m.v ? 1 : 0));
          ctx.globalAlpha = 1;
        });
      });

      ctx.fillStyle = COLORS.muted;
      ctx.font = '11px "IBM Plex Mono", monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      hist.forEach((p, i) => {
        if (i % 2 !== 0 && hist.length > 8) return;
        const x = pad.l + i * groupW + groupW / 2;
        ctx.fillText(shortPeriod(p.period), x, h - pad.b + 8);
      });

      const legend = document.getElementById('legend-volume');
      if (legend) {
        legend.innerHTML = `
          <span><i style="background:${COLORS.delivered}"></i>Delivered</span>
          <span><i style="background:${COLORS.noShow}"></i>No-shows</span>
          <span><i style="background:${COLORS.abandoned}"></i>Abandoned</span>
        `;
      }

      chartState['chart-volume'] = {
        centre: c,
        w,
        h,
        hitTest(mx) {
          const g = groups.find((row) => mx >= row.x0 && mx <= row.x1);
          if (!g) return null;
          return {
            ...g,
            html: `<strong>${longPeriod(g.period)}</strong>
              ${g.metrics
                .map((m) => `<div>${m.label}: <b>${fmtCount(m.v)}</b></div>`)
                .join('')}`,
          };
        },
      };
      bindChart('chart-volume', paintVolumeChart);
    }

    function paintRankChart(c, hover) {
      const setup = setupCanvas('chart-rank');
      if (!setup) return;
      const { ctx, w, h } = setup;
      ctx.clearRect(0, 0, w, h);
      const ranked = centres
        .filter((x) => x.passRate != null)
        .sort((a, b) => a.passRate - b.passRate);
      if (!ranked.length) return;

      const min = Math.min(...ranked.map((x) => x.passRate));
      const max = Math.max(...ranked.map((x) => x.passRate));
      const xPad = { t: 12, r: 70, b: 28, l: 12 };
      const xPlotW = w - xPad.l - xPad.r;
      const xPlotH = h - xPad.t - xPad.b;
      const rowH = xPlotH / ranked.length;

      const nat = payload.meta?.national?.passRate;
      if (nat != null) {
        const nx = xPad.l + ((nat - min) / (max - min || 1)) * xPlotW;
        ctx.strokeStyle = COLORS.national;
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(nx, xPad.t);
        ctx.lineTo(nx, h - xPad.b);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = COLORS.national;
        ctx.font = '11px "IBM Plex Mono", monospace';
        ctx.textAlign = 'center';
        ctx.fillText(`Nat ${nat}%`, nx, h - xPad.b + 12);
      }

      const rows = ranked.map((row, i) => {
        const bw = ((row.passRate - min) / (max - min || 1)) * xPlotW;
        const y = xPad.t + i * rowH;
        return {
          ...row,
          bw,
          y,
          h: Math.max(rowH - 1, 1),
          rank: ranked.length - i,
        };
      });

      rows.forEach((row) => {
        const isSelf = row.slug === c.slug;
        const isHover = hover && hover.slug === row.slug;
        ctx.fillStyle = isSelf ? COLORS.highlight : COLORS.other;
        ctx.globalAlpha = isSelf || isHover ? 1 : hover ? 0.28 : 0.55;
        ctx.fillRect(xPad.l, row.y, Math.max(row.bw, 2), row.h);
        ctx.globalAlpha = 1;
        if (isSelf || isHover) {
          ctx.fillStyle = COLORS.ink;
          ctx.font = '600 12px "Source Sans 3", sans-serif';
          ctx.textAlign = 'left';
          ctx.textBaseline = 'middle';
          ctx.fillText(
            `${row.name} ${row.passRate}% · #${row.rank}`,
            xPad.l + row.bw + 6,
            row.y + rowH / 2,
          );
        }
      });

      const legend = document.getElementById('legend-rank');
      if (legend) {
        legend.innerHTML = `
          <span><i style="background:${COLORS.highlight}"></i>${c.name}</span>
          <span><i style="background:${COLORS.other}"></i>Other centres</span>
          <span><i style="background:${COLORS.national}"></i>National average</span>
        `;
      }

      chartState['chart-rank'] = {
        centre: c,
        w,
        h,
        hitTest(_mx, my) {
          const row = rows.find((r) => my >= r.y && my <= r.y + rowH);
          if (!row) return null;
          const gap =
            nat == null ? null : Math.round((row.passRate - nat) * 10) / 10;
          return {
            ...row,
            html: `<strong>${row.name}</strong>
              <div>Pass rate: <b>${row.passRate}%</b></div>
              <div>Ireland rank: <b>#${row.rank}</b> of ${ranked.length}</div>
              ${gap == null ? '' : `<div>vs national: <b>${gap > 0 ? '+' : ''}${gap} pp</b></div>`}`,
          };
        },
      };
      bindChart('chart-rank', paintRankChart);
    }

    function render(slug) {
      const c = bySlug[slug] || centres[0];
      if (!c) return;
      hideTooltip();
      renderStats(c);
      paintPassChart(c, null);
      paintWaitChart(c, null);
      paintVolumeChart(c, null);
      paintRankChart(c, null);
      const url = new URL(window.location.href);
      url.searchParams.set('centre', c.slug);
      window.history.replaceState({}, '', url);
    }

    function init() {
      const params = new URLSearchParams(window.location.search);
      const fromQuery = params.get('centre');
      const initial =
        (fromQuery && bySlug[fromQuery] && fromQuery) ||
        root?.dataset.default ||
        centres[0]?.slug;
      if (select && initial) select.value = initial;
      render(initial);
    }

    select?.addEventListener('change', () => render(select.value));
    window.addEventListener('resize', () => {
      if (select?.value) render(select.value);
    });
    init();
  </script>
</BaseLayout>

