---
interface Props {
  values: (number | null)[];
  label?: string;
  width?: number;
  height?: number;
}

const { values, label = 'Trend', width = 280, height = 64 } = Astro.props;
const nums = values.filter((v): v is number => typeof v === 'number');
---

{
  nums.length < 2 ? (
    <p class="stat__note">Trend chart available after the next CSO update.</p>
  ) : (
    (() => {
      const min = Math.min(...nums);
      const max = Math.max(...nums);
      const span = max - min || 1;
      const pad = 4;
      const pts = nums
        .map((v, i) => {
          const x = pad + (i / (nums.length - 1)) * (width - pad * 2);
          const y = height - pad - ((v - min) / span) * (height - pad * 2);
          return `${x.toFixed(1)},${y.toFixed(1)}`;
        })
        .join(' ');
      return (
        <svg
          class="sparkline"
          viewBox={`0 0 ${width} ${height}`}
          role="img"
          aria-label={label}
        >
          <polyline
            fill="none"
            stroke="#0c6e5a"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            points={pts}
          />
        </svg>
      );
    })()
  )
}
